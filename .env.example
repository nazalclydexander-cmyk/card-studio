# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Recommended for production and Supabase Auth redirect consistency
# Example: https://your-project.vercel.app or your future custom domain
NEXT_PUBLIC_SITE_URL=https://your-production-site-url

# Optional Playwright E2E configuration
# Defaults to http://localhost:3000 when not provided
PLAYWRIGHT_BASE_URL=

# Optional admin E2E credentials for authenticated read-only tests
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
