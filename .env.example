# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Recommended for production and Supabase Auth redirect consistency
# Example: https://your-project.vercel.app or your future custom domain
NEXT_PUBLIC_SITE_URL=https://your-production-site-url

# Server-only key for protected security workflows such as inquiry abuse controls.
# Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secret used to HMAC-hash inquiry abuse identifiers such as IPs/emails.
# Required in production. Local development falls back to a safe local-only default.
RATE_LIMIT_HASH_SECRET=

# Cloudflare Turnstile.
# The site key is public and may be exposed to the browser.
# The secret key must remain server-side only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional inquiry abuse-control overrides
CUSTOMER_INQUIRY_IP_LIMIT=3
CUSTOMER_INQUIRY_IP_WINDOW_SECONDS=600
CUSTOMER_INQUIRY_IP_DAILY_LIMIT=10
CUSTOMER_INQUIRY_IP_DAILY_WINDOW_SECONDS=86400
CUSTOMER_INQUIRY_EMAIL_LIMIT=3
CUSTOMER_INQUIRY_EMAIL_WINDOW_SECONDS=3600
CUSTOMER_INQUIRY_DUPLICATE_WINDOW_SECONDS=600
CUSTOMER_INQUIRY_MAX_BODY_BYTES=65536

# Optional Playwright E2E configuration
# Defaults to http://localhost:3000 when not provided
PLAYWRIGHT_BASE_URL=

# Optional admin E2E credentials for authenticated read-only tests
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
